/* 全局样式定义与深浅色主题 */
page {
  background-color: #020617;
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  box-sizing: border-box;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
}

/* Theme Switcher Classes */
.theme-dark {
  background-color: #020617 !important;
  color: #f8fafc !important;
}

.theme-light {
  background-color: #f1f5f9 !important;
  color: #0f172a !important;
}

.theme-light .card {
  background-color: #ffffff !important;
  border-color: #cbd5e1 !important;
  color: #0f172a !important;
}

.theme-light .title {
  color: #0f172a !important;
}

.theme-light .input {
  background-color: #f8fafc !important;
  border-color: #cbd5e1 !important;
  color: #0f172a !important;
}

.theme-light .notice-box {
  background-color: #f8fafc !important;
  border-color: #e2e8f0 !important;
}

.theme-light .notice-item {
  color: #334155 !important;
}

.theme-light .detail-card {
  background-color: #f8fafc !important;
}

.theme-light .q-title {
  color: #0f172a !important;
}

.theme-light .score-card {
  background: linear-gradient(135deg, #ffffff, #f8fafc) !important;
  border-color: #0284c7 !important;
}

.btn-theme-toggle {
  display: inline-block;
  background: #1e293b;
  color: #38bdf8;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #334155;
  margin: 0;
}

.theme-light .btn-theme-toggle {
  background: #e2e8f0;
  color: #0284c7;
  border-color: #cbd5e1;
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.btn-primary {
  background: linear-gradient(to right, #0284c7, #4f46e5);
  color: #ffffff;
  font-weight: bold;
  border-radius: 20rpx;
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
}

.card {
  background-color: #0f172a;
  border: 1rpx solid #1e293b;
  border-radius: 30rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}
